# Domains pointing at this VM. Caddy gets TLS certificates for them automatically.
ZIMUA_DOMAIN=ide.example.com
# A separate domain for app previews, so a previewed app can't touch your IDE session.
ZIMUA_PREVIEW_DOMAIN=preview.example.com

# Long random string: `openssl rand -hex 32`. Signs sessions and encrypts stored tokens;
# changing it signs you out and makes stored tokens unreadable.
ZIMUA_SECRET_KEY=

# GitHub OAuth app (https://github.com/settings/developers).
# Callback URL: https://<ZIMUA_DOMAIN>/api/auth/callback
ZIMUA_GITHUB_CLIENT_ID=
ZIMUA_GITHUB_CLIENT_SECRET=

# Your GitHub username. Nobody else can sign in.
ZIMUA_ALLOWED_GITHUB_LOGIN=

# Group id owning /var/run/docker.sock on the host: `stat -c %g /var/run/docker.sock`.
DOCKER_GID=
