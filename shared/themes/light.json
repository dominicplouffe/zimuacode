{
  "name": "Light",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#3b3b3b",
    "editor.lineHighlightBackground": "#f5f5f5",
    "editor.selectionBackground": "#add6ff",
    "editorCursor.foreground": "#000000",
    "editorLineNumber.foreground": "#6e7681",
    "activityBar.background": "#f8f8f8",
    "activityBar.foreground": "#1f1f1f",
    "activityBar.inactiveForeground": "#616161",
    "sideBar.background": "#f8f8f8",
    "sideBar.foreground": "#3b3b3b",
    "sideBarSectionHeader.background": "#f3f3f3",
    "tab.activeBackground": "#ffffff",
    "tab.inactiveBackground": "#f8f8f8",
    "tab.activeForeground": "#3b3b3b",
    "tab.inactiveForeground": "#868686",
    "tab.border": "#e5e5e5",
    "statusBar.background": "#005fb8",
    "statusBar.foreground": "#ffffff",
    "panel.background": "#f8f8f8",
    "panel.border": "#e5e5e5",
    "focusBorder": "#005fb8",
    "list.hoverBackground": "#f0f0f0",
    "list.activeSelectionBackground": "#e4e6f1",
    "list.activeSelectionForeground": "#000000",
    "input.background": "#ffffff",
    "input.foreground": "#3b3b3b",
    "input.border": "#cecece",
    "button.background": "#005fb8",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#0258a8",
    "quickInput.background": "#f8f8f8",
    "descriptionForeground": "#616161",
    "errorForeground": "#e51400",
    "widget.shadow": "#00000029",
    "gitDecoration.modifiedResourceForeground": "#895503",
    "gitDecoration.addedResourceForeground": "#587c0c",
    "gitDecoration.deletedResourceForeground": "#ad0707",
    "testing.iconPassed": "#388a34",
    "testing.iconFailed": "#f14c4c",
    "testing.iconQueued": "#bf8803",
    "badge.background": "#cccccc",
    "badge.foreground": "#3b3b3b",
    "button.secondaryBackground": "#e5e5e5",
    "button.secondaryForeground": "#3b3b3b",
    "textLink.foreground": "#005fb8",
    "textCodeBlock.background": "#f0f0f0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#008000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#0000ff"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#a31515"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "number"
      ],
      "settings": {
        "foreground": "#098658"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#795e26"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "type"
      ],
      "settings": {
        "foreground": "#267f99"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#001080"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "tag"
      ],
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "attribute.name"
      ],
      "settings": {
        "foreground": "#e50000"
      }
    }
  ]
}
